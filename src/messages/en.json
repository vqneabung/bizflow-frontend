  "about": {
    "title": "About Bizflow",
    "mission": "Bizflow is a digital transformation platform designed specifically for traditional household businesses in Vietnam — especially construction material stores, grocery stores, and Group 1 & Group 2 businesses as defined by Decision 3389/QĐ-BTC (2025).",
    "challenge": "According to surveys, most household businesses still operate fully manually — using notebooks and Excel. They lack equipment (computers, receipt printers, barcode scanners) and budget for accountants. Bizflow was created to solve this problem.",
    "solution": "Our Solutions",
    "solutions": [
      { "title": "Multi-channel Sales", "desc": "Support counter sales, phone/Zalo orders, and AI-generated orders." },
      { "title": "Debt Management", "desc": "Auto-record debts, track long-term transaction history." },
      { "title": "Financial Reports", "desc": "Auto-generate reports per Circular 88/2021/TT-BTC, tax-ready." },
      { "title": "Smart AI", "desc": "AI understands natural language, auto-creates draft orders from voice or text." }
    ],
    "techStack": "Technology Stack"
  },

